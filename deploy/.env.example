# Copy to /opt/gat2027/.env on the server and fill in real values.
# This file is read by the systemd unit (EnvironmentFile=) - keep it out of git.

PORT=8080

# Postgres connection. Either form works:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#   DATABASE_URL=jdbc:postgresql://host:5432/dbname   (+ DATABASE_USERNAME / DATABASE_PASSWORD)
DATABASE_URL=postgres://gat_app:CHANGE_ME@localhost:5432/gat2027

# First-boot admin account (change the password after first login).
GAT_ADMIN_PHONE=08000000000
GAT_ADMIN_PASSWORD=CHANGE_ME

# Cookie signing key for "remember me" - any long random string, keep it stable across restarts.
GAT_REMEMBER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Outbound email (leave blank to keep the dev-mode fallback that logs reset links instead of emailing them).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=GAT 2027 <no-reply@yourdomain.ng>
